---
import { contact, fullName, navItems } from '@/constants';
---

<header
  id={navItems.home.slug}
  class="rule-top rule-bottom flex min-h-dvh flex-col justify-between gap-lg pb-lg desktop:p-0">
  <h1 class="sticky top-0 z-sticky bg-background-transparent p-md font-regular text-lg desktop:justify-self-start">
    {fullName}
  </h1>
  <div class="flex flex-col gap-lg p-md desktop:gap-md">
    <h2 class="font-regular">
      <strong class="gradient-text">Platform engineer and front&#x2011;end architect</strong> with 15+ years shipping production&#x2011;grade
      systems. I define how UIs get built: from design&#x2011;system infrastructure and{' '}
      <strong class="gradient-text">AI agent tooling</strong> to the testing contracts and quality bars that make them reliable
      at scale. Currently doing that at{' '}
      <a href="https://www.docker.com" target="_blank" rel="noopener noreferrer">Docker</a>.
    </h2>
    <nav class="flex justify-between gap-sm desktop:justify-start desktop:gap-lg">
      {
        contact.map((item) => (
          <a href={item.href} download={item.download} target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  @reference '../styles/global.css';

  h2 {
    max-width: min(36ch, 100%);
  }
</style>
