---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section
  id={id}
  class="rule-bottom w-full items-start desktop:col-start-1 desktop:col-end-4 wide:col-end-5 desktop:grid desktop:grid-cols-subgrid desktop:justify-items-start">
  <h3
    class="sticky top-0 z-sticky justify-self-stretch bg-background-transparent p-md font-regular text-lg desktop:justify-self-start">
    {label}
  </h3>
  <hr class="vertical" />
  <div
    class="grid items-start px-md pb-md desktop:col-start-3 desktop:col-end-5 desktop:grid-cols-subgrid desktop:justify-items-start desktop:pt-md">
    <slot />
  </div>
</section>

<style>
  @reference '../styles/global.css';

  section {
    min-height: 50vh;
    @supports (height: 50dvh) {
      min-height: 50dvh;
    }
  }
</style>
