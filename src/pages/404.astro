---
import '@/kinetic/kinetic.css';

import { boot } from '@/kinetic/boot';
import { railLayout } from '@/kinetic/panels';
import { fullName } from '@/constants';
---

<html lang="en" style={`--fit: ${railLayout.fit}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found | {fullName}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/recursive-text.woff2" crossorigin />
    <script is:inline set:html={boot} />
  </head>
  <body>
    <main class="panel">
      <h1 class="font-kinetic text-poster">404</h1>
      <p class="lead">That page doesn't exist.</p>
      <p class="lead"><a href="/">Go to derekmisler.com</a></p>
    </main>
  </body>
</html>
