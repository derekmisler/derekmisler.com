---
import NavToggle from '@/components/NavToggle.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { navItems } from '@/constants';

const navItemsArray = Object.values(navItems);
---

<nav class="nav fixed-full overlay-hidden">
  {
    navItemsArray.map(({ slug, label }) => (
      <a href={`#${slug}`} data-target={slug}>
        <strong>{label}</strong>
      </a>
    ))
  }
</nav>
<ThemeToggle />
<NavToggle />

<script>
  // Click to scroll with smooth behavior (progressive enhancement over native anchor jump)
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav a[data-target]');
  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      // Let modifier-key clicks (new tab, new window) and non-left-clicks pass through
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const target = link.getAttribute('data-target');
      if (!target) return;
      const targetElement = document.getElementById(target);
      document.body.removeAttribute('data-hidden');
      targetElement?.scrollIntoView({ behavior: 'smooth' });
      // Update URL fragment without triggering a jump
      history.pushState(null, '', `#${target}`);
    });
  });
</script>

<style>
  .nav {
    overflow: hidden;
    background-color: var(--color-background);
    padding: var(--space-md);
  }
  .nav a {
    --border-width: 10px;
    padding: 0;
    margin-bottom: var(--space-sm);
    width: 100%;
    text-align: left;
    font-size: var(--font-size-xxl);
    line-height: var(--line-height-tight);
    width: fit-content;
    display: block;
    text-decoration: none;
    color: inherit;
  }
</style>
