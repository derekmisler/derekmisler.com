---
import '@/kinetic/kinetic.css';

import { AstroSeo } from '@astrolib/seo';

import Rail from '@/kinetic/Rail.astro';
import ThemeToggle from '@/kinetic/ThemeToggle.astro';
import Track from '@/kinetic/Track.astro';
import { boot } from '@/kinetic/boot';
import { panels, railGap, railLayout } from '@/kinetic/panels';
import { swapKeyframes } from '@/kinetic/swaps';
import { description, education, firstName, fullName, jobTitle, lastName, skills, socialId, title } from '@/constants';

const swaps = `@media (prefers-reduced-motion: no-preference){${swapKeyframes()}}`;
const timelines = panels.map((panel) => panel.timeline).join(', ');

const siteUrl = 'https://derekmisler.com';
const imageAlt = 'Pop-art comic portrait of Derek Misler on yellow Ben-Day dots';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  jobTitle,
  description,
  url: siteUrl,
  knowsAbout: skills.flatMap(([, items]) => items),
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.location },
  sameAs: [`https://www.linkedin.com/in/${socialId}`, `https://github.com/${socialId}`],
  worksFor: {
    '@type': 'Organization',
    name: 'Docker',
    url: 'https://www.docker.com',
  },
};
---

<html lang="en" style={`timeline-scope: ${timelines}; --fit: ${railLayout.fit}; --rail-gap: ${railGap}em`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/recursive-text.woff2" crossorigin />
    <script is:inline set:html={boot} />
    <style is:inline set:html={swaps}></style>
    <AstroSeo
      title={`${fullName} | ${title}`}
      description={description}
      canonical={Astro.url.href}
      openGraph={{
        type: 'website',
        url: Astro.url.href,
        title: `${fullName} | ${title}`,
        description,
        profile: {
          firstName: firstName,
          lastName: lastName,
          username: socialId,
        },
        images: [
          {
            url: `${siteUrl}/square.jpg`,
            width: 1200,
            height: 1200,
            alt: imageAlt,
            type: 'image/jpeg',
          },
          {
            url: `${siteUrl}/horizontal.jpg`,
            width: 1200,
            height: 630,
            alt: `${imageAlt}, next to his name`,
            type: 'image/jpeg',
          },
        ],
      }}
      additionalLinkTags={[
        { rel: 'icon', href: '/favicon.ico', sizes: '16x16 32x32 48x48' },
        { rel: 'icon', href: '/icon-192.png', type: 'image/png', sizes: '192x192' },
        { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
      ]}
      additionalMetaTags={[
        {
          name: 'google-site-verification',
          content: 'oM1NjzxvtvPp4JL2t2qo13zUhGnrpGF0Fbgyb6S8vDk',
        },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:site', content: `@${socialId}` },
        { name: 'twitter:creator', content: `@${socialId}` },
        { name: 'twitter:title', content: `${fullName} | ${title}` },
        { name: 'twitter:description', content: description },
        { name: 'twitter:image', content: `${siteUrl}/horizontal.jpg` },
        { name: 'twitter:image:alt', content: `${imageAlt}, next to his name` },
      ]}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link sr-only focus:not-sr-only" href={`#${panels[0].id}`}>Skip to main content</a>
    <Rail />
    <Track />
    <ThemeToggle />
    <script>
      import '@/kinetic/switcher';
      import '@/kinetic/pointer';
      import '@/kinetic/focus';
      import '@/kinetic/shuffle';
    </script>
  </body>
</html>
