---
import AccomplishmentList from '@/components/AccomplishmentList.astro';
import CareerEntry from '@/components/CareerEntry.astro';
import ContactLink from '@/components/ContactLink.astro';
import Section from '@/components/Section.astro';
import SkillCategory from '@/components/SkillCategory.astro';
import { contact, currentCareers, education, highlights, navItems, skills, subHeadline, tools } from '@/constants';
---

<main id="main-content" class="grid">
  <Section id={navItems.about.slug} label={navItems.about.label}>
    <h4>Background</h4>
    <p>{subHeadline}</p>
    <h4>Highlights</h4>
    <AccomplishmentList items={highlights} />
    <h4>Education</h4>
    <p>{education.title}</p>
  </Section>

  <Section id={navItems.experience.slug} label={navItems.experience.label}>
    {
      currentCareers.map((career) => (
        <CareerEntry
          location={career.location}
          link={career.link}
          title={career.title}
          startDate={career.startDate}
          endDate={career.endDate}
          accomplishments={career.accomplishments}
        />
      ))
    }
  </Section>

  <Section id={navItems.coreSkills.slug} label={navItems.coreSkills.label}>
    {skills.map(([category, skillList]) => <SkillCategory category={category} skills={skillList} />)}
  </Section>

  <Section id={navItems.workingWith.slug} label={navItems.workingWith.label}>
    {tools.map(([category, toolList]) => <SkillCategory category={category} skills={toolList} variant="primary" />)}
  </Section>

  <Section id={navItems.contact.slug} label={navItems.contact.label}>
    {
      contact.map((item) => (
        <ContactLink
          href={item.href}
          label={item.label}
          altLabel={item.altLabel}
          download={item.download}
          icon={item.icon}
          variant="detail"
        />
      ))
    }
  </Section>
</main>

<style>
  main {
    width: 100%;
    align-items: baseline;
    padding: 0;
  }
  .grid {
    --columns: auto;
    @media (min-width: 1024px) {
      --columns: min-content var(--border-width) auto;
    }
    @media (min-width: 1280px) {
      --columns: auto var(--border-width) min-content auto;
    }
    @media (min-width: 1440px) {
      --columns: auto var(--border-width) auto auto;
    }

    display: grid;
    grid-template-columns: var(--columns);
    column-gap: var(--space-md);
    row-gap: 0;
  }
  main :global(p:not(:last-child)),
  main :global(ul:not(:last-child)) {
    margin-bottom: var(--space-md);
  }
  /*
   * Career entry layout in the Experience section.
   *
   * display:contents makes .career-entry disappear as a box so its two
   * children (.career-left and ul) become direct children of the subgrid,
   * filling one row each: company name + title/dates on the left, bullets
   * on the right. Multiple entries stack as consecutive subgrid rows.
   *
   * On mobile (single-column) display:contents is still fine -- block flow
   * means .career-left then ul stack naturally.
   */
  main :global(.career-entry) {
    display: contents;
  }

  /* On mobile the ul follows career-left in flow; give it a clear gap
     before the first bullet. On desktop it sits in the right subgrid
     column so this margin is reset to avoid pushing bullets down. */
  main :global(.career-entry > ul) {
    margin-top: var(--space-md);
    @media (min-width: 1024px) {
      margin-top: 0;
    }
  }
  /* Separate consecutive entries with top spacing on the left cell. */
  main :global(.career-left + ul + .career-entry > .career-left),
  main :global(.career-entry ~ .career-entry > .career-left) {
    margin-top: var(--space-lg);
  }

  main :global(.career-left > *) {
    line-height: var(--line-height-body);
  }
</style>
