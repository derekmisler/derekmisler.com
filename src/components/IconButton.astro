---
interface Props {
  id: string;
  position: 'top' | 'bottom';
  ariaLabel: string;
}

const { id, position, ariaLabel } = Astro.props;
---

<button
  class:list={[
    'icon-button fixed right-sm z-overlay bg-background-transparent p-xs desktop:right-md',
    { 'top-sm': position === 'top', 'bottom-sm': position === 'bottom' },
  ]}
  id={id}
  aria-label={ariaLabel}>
  <slot />
</button>

<style>
  @reference '../styles/global.css';

  .icon-button {
    width: calc(40px + --theme(--spacing-xs) * 2);
    height: calc(40px + --theme(--spacing-xs) * 2);
  }
  :global(body[data-hidden] .icon-button) {
    @media (pointer: fine) {
      margin-right: var(--rule);
    }
  }
</style>
