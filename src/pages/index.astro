---
import '@/styles/global.css';
import '@/styles/ibm-plex-mono.css';
import '@/styles/press-start-2p.css';

import { AstroSeo } from '@astrolib/seo';

import Header from '@/components/Header.astro';
import Main from '@/components/Main.astro';
import Nav from '@/components/Nav.astro';
import { description, firstName, fullName, jobTitle, lastName, socialId, title } from '@/constants';

const siteUrl = 'https://derekmisler.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  jobTitle,
  url: siteUrl,
  sameAs: [`https://www.linkedin.com/in/${socialId}`, `https://github.com/${socialId}`],
  worksFor: {
    '@type': 'Organization',
    name: 'Docker',
    url: 'https://www.docker.com',
  },
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Preload critical woff2 fonts. The swap window is near-zero because the
        font arrives before first paint. All other weights use font-display:
        swap, so they never block rendering. */
    }
    <link rel="preload" as="font" type="font/woff2" href="/fonts/pixel/woff2/PressStart2P-Regular.woff2" crossorigin />
    <AstroSeo
      title={`${fullName} | ${title}`}
      description={description}
      canonical={Astro.url.href}
      openGraph={{
        type: 'website',
        url: Astro.url.href,
        title: `${fullName} | ${title}`,
        description,
        profile: {
          firstName: firstName,
          lastName: lastName,
          username: socialId,
        },
        images: [
          {
            url: `${siteUrl}/square.jpg`,
            width: 1200,
            height: 1080,
            alt: 'Square image of Derek Misler',
            type: 'image/jpeg',
          },
          {
            url: `${siteUrl}/horizontal.jpg`,
            width: 800,
            height: 440,
            alt: 'Horizontal image of Derek Misler',
            type: 'image/jpeg',
          },
        ],
      }}
      additionalLinkTags={[{ rel: 'icon', href: `${Astro.url.href}favicon.ico` }]}
      additionalMetaTags={[
        {
          name: 'google-site-verification',
          content: 'oM1NjzxvtvPp4JL2t2qo13zUhGnrpGF0Fbgyb6S8vDk',
        },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:site', content: `@${socialId}` },
        { name: 'twitter:creator', content: `@${socialId}` },
        { name: 'twitter:title', content: `${fullName} | ${title}` },
        { name: 'twitter:description', content: description },
        { name: 'twitter:image', content: `${siteUrl}/horizontal.jpg` },
        { name: 'twitter:image:alt', content: 'Horizontal image of Derek Misler' },
      ]}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav />
    <Header />
    <Main />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 0;
    z-index: 9999;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-background);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    border: 2px solid currentColor;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
