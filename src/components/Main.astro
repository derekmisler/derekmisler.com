---
import Section from '@/components/Section.astro';
import { contact, navItems, statements } from '@/constants';
---

<main id="main-content" class="grid w-full items-baseline gap-x-md">
  {
    statements.map(({ slug, label, period, headline, detail }) => (
      <Section id={slug} label={label}>
        <div class="flex flex-col gap-md desktop:col-span-full">
          <h6>{period}</h6>
          <h4 class="text-xl">{headline}</h4>
          <p>{detail}</p>
        </div>
      </Section>
    ))
  }

  <Section id={navItems.contact.slug} label={navItems.contact.label}>
    {
      contact.map((item) => (
        <>
          <h4>{item.label}</h4>
          <p class="not-last:mb-md">
            <a href={item.href} download={item.download} target="_blank" rel="noopener noreferrer">
              {item.altLabel}
            </a>
          </p>
        </>
      ))
    }
    <h4>For AI agents</h4>
    <p><a href="/llms.txt">llms.txt</a> and <a href="/llms-full.txt">llms-full.txt</a></p>
  </Section>
</main>

<style>
  @reference '../styles/global.css';

  main {
    grid-template-columns: auto;
    @variant desktop {
      grid-template-columns: min-content var(--rule) auto;
    }
    @variant wide {
      grid-template-columns: auto var(--rule) min-content auto;
    }
    @variant xwide {
      grid-template-columns: auto var(--rule) auto auto;
    }
  }
</style>
