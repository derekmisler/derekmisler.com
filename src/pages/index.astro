---
import '@/styles/global.css';
import '@/styles/ibm-plex-sans-all.css';

import { AstroSeo } from '@astrolib/seo';
import { getCollection } from 'astro:content';

import Header from '@/components/Header.astro';
import Main from '@/components/Main.astro';
import Nav from '@/components/Nav.astro';
import Section from '@/components/Section.astro';
import { description, firstName, fullName, jobTitle, lastName, socialId, title } from '@/constants';

// Fetch non-draft posts for the Writing section.
// Returns empty array until the first post is published — section stays hidden.
const recentPosts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const siteUrl = 'https://derekmisler.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  jobTitle,
  url: siteUrl,
  sameAs: [`https://www.linkedin.com/in/${socialId}`, `https://github.com/${socialId}`],
  worksFor: {
    '@type': 'Organization',
    name: 'Docker',
    url: 'https://www.docker.com',
  },
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Preload critical woff2 fonts. The swap window is near-zero because the
        font arrives before first paint. All other weights use font-display:
        optional and are never preloaded, so they cause no FOUT. */
    }
    <link rel="preload" as="font" type="font/woff2" href="/fonts/sans/woff2/IBMPlexSans-Text.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/sans/woff2/IBMPlexSans-Bold.woff2" crossorigin />
    <AstroSeo
      title={`${fullName} | ${title}`}
      description={description}
      canonical={Astro.url.href}
      openGraph={{
        type: 'website',
        url: Astro.url.href,
        title: `${fullName} | ${title}`,
        description,
        profile: {
          firstName: firstName,
          lastName: lastName,
          username: socialId,
        },
        images: [
          {
            url: `${siteUrl}/square.jpg`,
            width: 1200,
            height: 1080,
            alt: 'Square image of Derek Misler',
            type: 'image/jpeg',
          },
          {
            url: `${siteUrl}/horizontal.jpg`,
            width: 800,
            height: 440,
            alt: 'Horizontal image of Derek Misler',
            type: 'image/jpeg',
          },
        ],
      }}
      additionalLinkTags={[{ rel: 'icon', href: `${Astro.url.href}favicon.ico` }]}
      additionalMetaTags={[
        {
          name: 'google-site-verification',
          content: 'oM1NjzxvtvPp4JL2t2qo13zUhGnrpGF0Fbgyb6S8vDk',
        },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:site', content: `@${socialId}` },
        { name: 'twitter:creator', content: `@${socialId}` },
        { name: 'twitter:title', content: `${fullName} | ${title}` },
        { name: 'twitter:description', content: description },
        { name: 'twitter:image', content: `${siteUrl}/horizontal.jpg` },
        { name: 'twitter:image:alt', content: 'Horizontal image of Derek Misler' },
      ]}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Writing — ${fullName}`} href="/writing.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav />
    <Header />
    <Main />
    {
      recentPosts.length > 0 && (
        <section class="writing-section grid">
          <Section id="writing" label="Writing">
            <ul class="writing-list">
              {recentPosts.map((post) => (
                <li class="writing-item">
                  <small>
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                    </time>
                  </small>
                  <a href={`/writing/${post.id}`}>{post.data.title}</a>
                </li>
              ))}
            </ul>
            {recentPosts.length >= 3 && (
              <p>
                <a href="/writing">All writing →</a>
              </p>
            )}
          </Section>
        </section>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 0;
    z-index: 9999;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-background);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    border: 2px solid currentColor;
  }
  .skip-link:focus {
    top: 0;
  }

  .writing-section.grid {
    /* Mirror the grid from Main.astro so Writing aligns with other sections */
    --columns: auto;
    @media (min-width: 1024px) {
      --columns: min-content var(--border-width) auto;
    }
    @media (min-width: 1280px) {
      --columns: auto var(--border-width) min-content auto;
    }
    @media (min-width: 1440px) {
      --columns: auto var(--border-width) auto auto;
    }
    display: grid;
    grid-template-columns: var(--columns);
    column-gap: var(--space-md);
    row-gap: 0;
    width: 100%;
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: 0;
    margin: 0;
  }

  .writing-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
  }

  @media (min-width: 640px) {
    .writing-item {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-md);
    }
  }

  .writing-item small {
    white-space: nowrap;
    opacity: 0.6;
  }

  .writing-item a {
    font-weight: 700;
  }
</style>
