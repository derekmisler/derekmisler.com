---
const { id, label } = Astro.props;
---

<section id={id} class="nes-container section-wrapper border-accent-bottom" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="section-label sticky-header">{label}</h2>
  <hr class="vertical" />
  <div class="content content-padding">
    <slot />
  </div>
</section>

<style>
  /*
   * .nes-container adds a pixel border and position:relative.
   * We zero out its default padding so the subgrid geometry is
   * unaffected; .sticky-header and .content-padding handle spacing.
   * The outer section itself is a subgrid participant via the grid
   * context in Main.astro.
   */
  .section-wrapper {
    padding: 0 !important;
    align-items: start;
    width: 100%;
    min-height: 50vh;
    @supports (height: 50dvh) {
      min-height: 50dvh;
    }
    @media (min-width: 1024px) {
      grid-column: 1 / 4;
      display: grid;
      grid-template-columns: subgrid;
      grid-auto-rows: subgrid;
      justify-items: start;
    }
    @media (min-width: 1280px) {
      grid-column: 1 / 5;
    }
  }

  .section-label {
    justify-self: stretch;
    font-size: var(--font-size-lg);
    font-weight: 400;
    /* Match the h1 right-pad so section labels never slide under the fixed
       nav-toggle when sticky at the top of the viewport on mobile. */
    padding-right: calc(40px + var(--space-xs) * 2 + var(--space-sm) + var(--space-xs)) !important;
    @media (min-width: 1024px) {
      justify-self: start;
      padding-right: var(--space-md) !important;
    }
  }

  .content {
    padding-top: 0;
    align-items: start;
    display: grid;
    @media (min-width: 1024px) {
      padding-top: var(--space-md);
      grid-column: 3 / 5;
      grid-template-columns: subgrid;
      justify-items: start;
    }
  }
</style>
