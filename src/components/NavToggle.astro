---
import IconButton from '@/components/IconButton.astro';
---

<IconButton id="nav-toggle" ariaLabel="Toggle navigation" position="top">
  <span class="container flex h-xs place-items-center">
    <span class="inner block"></span>
  </span>
</IconButton>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const nav = document.querySelector<HTMLDivElement>('.nav');
  navToggle?.addEventListener('click', () => {
    nav?.toggleAttribute('data-active');
    document.body.toggleAttribute('data-hidden');
  });
</script>

<style>
  @reference '../styles/global.css';

  .container {
    width: 40px;
  }
  .inner,
  .inner::before,
  .inner::after {
    position: absolute;
    width: 40px;
    height: calc(--theme(--spacing-xs) / 2);
    background-color: --theme(--color-accent);
    transition:
      bottom 100ms --theme(--ease-out),
      top 100ms --theme(--ease-out);
  }
  .inner::before,
  .inner::after {
    display: block;
    content: '';
  }
  .inner::before {
    top: calc(--theme(--spacing-xs) * -2);
  }
  .inner::after {
    bottom: calc(--theme(--spacing-xs) * -2);
  }
  :global(body[data-hidden] .inner::before) {
    top: 0;
  }
  :global(body[data-hidden] .inner::after) {
    bottom: 0;
  }
</style>
