# Writing archive index — no caching: must reflect new posts immediately
/writing
  Cache-Control: public, max-age=0, must-revalidate
/writing/
  Cache-Control: public, max-age=0, must-revalidate

# Long-lived cache for static individual post pages
/writing/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Short cache for the RSS feed — must stay reasonably fresh
/writing.xml
  Cache-Control: public, max-age=3600
