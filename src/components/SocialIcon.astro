---
type IconName = 'github' | 'linkedin' | 'gmail' | 'twitter' | 'youtube' | 'instagram' | 'trophy';

interface Props {
  name: IconName;
  href: string;
  label: string;
  size?: 'small' | 'medium' | 'large';
  /** When true, renders the icon without a wrapping <a>. Use inside an
   *  existing link so the same destination isn't reachable twice by keyboard. */
  decorative?: boolean;
}

const { name, href, label, size = 'small', decorative = false } = Astro.props;
const sizeClass = size !== 'small' ? `is-${size}` : '';
---

{
  decorative ? (
    <i class:list={['nes-icon', name, sizeClass, 'icon-inline'].filter(Boolean)} aria-hidden="true" />
  ) : (
    <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="social-icon-link">
      <i class:list={['nes-icon', name, sizeClass].filter(Boolean)} aria-hidden="true" />
    </a>
  )
}

<style>
  /*
   * NES icons are 16x16 with transform:scale(2) and transform-origin:top left.
   * That shifts the visual centre upward relative to surrounding text. We
   * compensate by wrapping in an inline-flex container sized to the post-scale
   * footprint (32x32 for the default scale-2 icon) so adjacent text aligns
   * to the middle of the actual rendered glyph.
   */
  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    text-decoration: none;
    flex-shrink: 0;
    vertical-align: middle;
  }

  /*
   * Decorative variant (no anchor): used inside ContactLink detail headings.
   * Size the <i> into a 32x32 block so the heading stays vertically centred.
   * transform-origin:top left means the scaled glyph sits at (0,0) of the
   * 16x16 box; a translate of 50% of the difference between scaled and
   * unscaled dimensions recentres it visually.
   */
  .icon-inline {
    display: inline-block;
    width: 32px;
    height: 32px;
    margin: 0 !important;
    vertical-align: middle;
    transform: scale(2) translate(25%, 25%);
    transform-origin: top left;
    flex-shrink: 0;
  }
</style>
