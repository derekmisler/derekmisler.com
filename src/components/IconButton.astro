---
interface Props {
  id: string;
  position: 'top' | 'bottom';
  ariaLabel: string;
}

const { id, position, ariaLabel } = Astro.props;
---

<button
  class:list={[
    'fixed right-sm z-overlay box-content size-icon bg-background-transparent p-xs desktop:right-md in-data-hidden:pointer-fine:mr-rule',
    { 'top-sm': position === 'top', 'bottom-sm': position === 'bottom' },
  ]}
  id={id}
  aria-label={ariaLabel}>
  <slot />
</button>
