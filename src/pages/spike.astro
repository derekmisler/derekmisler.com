---
import '@/kinetic/kinetic.css';

import Split from '@/kinetic/Split.astro';
import Words from '@/kinetic/Words.astro';
import ThemeToggle from '@/kinetic/ThemeToggle.astro';
import { hourTheme } from '@/kinetic/hours';
import { swapKeyframes } from '@/kinetic/swaps';
import { contact, fullName, navItems, statements } from '@/constants';

type Panel = { id: string; poster: string; headline?: string; lead: string };

const panels = (
  [
  { id: 'intro', poster: fullName, lead: 'Front-\u2060end engineer at Docker. Type, layout and systems.' },
  ...statements.map((statement) => ({
    id: statement.slug,
    poster: statement.label,
    headline: statement.headline,
    lead: statement.detail,
  })),
  { id: navItems.contact.slug, poster: navItems.contact.label, lead: 'Say hello, or judge my code.' },
  ] satisfies Panel[] as Panel[]
).map((panel, index, all) => ({
  ...panel,
  size: `min(${(140 / Math.max(...panel.poster.split(' ').map((word) => word.length))).toFixed(1)}cqi, ${(42 / panel.poster.split(' ').length).toFixed(1)}svh)`,
  links: all[index + 1] ? [{ href: `#${all[index + 1].id}`, label: 'Next' }] : contact,
}));
const swaps = `@media (prefers-reduced-motion: no-preference){${swapKeyframes()}}`;
const timelines = panels.map((_, index) => `--p${index}`).join(', ');
const boot = `(function(r,t){function f(){requestAnimationFrame(function(){requestAnimationFrame(function(){r.dataset.fonts=''})})}document.fonts.load('1em Recursive').then(f,f);setTimeout(f,3e3);r.dataset.auto=(${hourTheme.toString()})(new Date().getHours());try{t=localStorage.getItem('theme')}catch(e){}t=/^(dawn|midday|dusk|night)$/.test(t)?t:'auto';r.dataset.choice=t;r.dataset.theme=t=='auto'?r.dataset.auto:t})(document.documentElement)`;
---

<html lang="en" style={`timeline-scope: ${timelines}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kinetic spike</title>
    <meta name="description" content="Kinetic typography spike" />
    <meta name="robots" content="noindex" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/recursive-text.woff2" crossorigin />
    <script is:inline set:html={boot} />
    <style is:inline set:html={swaps}></style>
  </head>
  <body>
    <ThemeToggle />
    <main class="wrap" style={`--count: ${panels.length}`}>
      {
        panels.map((panel, index) => (
          <div class="marker" style={`--index: ${index}; --timeline: --p${index}`} />
        ))
      }
      <div class="viewport">
        <div class="track">
          {
            panels.map((panel, index) => (
              <section
                class="panel"
                id={panel.id}
                tabindex="-1"
                aria-labelledby={`${panel.id}-title`}
                style={`--timeline: --p${index}; --index: ${index}; --poster-size: ${panel.size}`}
              >
                {index === 0 ? (
                  <h1 class="poster" id={`${panel.id}-title`}>
                    <Split text={panel.poster} />
                  </h1>
                ) : (
                  <h2 class="poster" id={`${panel.id}-title`}>
                    <Split text={panel.poster} />
                  </h2>
                )}
                {panel.headline && (
                  <p class="headline">
                    <Words text={panel.headline} />
                  </p>
                )}
                <p class="lead">{panel.lead}</p>
                <ul class="links">
                  {panel.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </main>
    <script>
      import '@/kinetic/switcher';
      import '@/kinetic/pointer';
      import '@/kinetic/focus';
      import '@/kinetic/shuffle';
    </script>
  </body>
</html>
