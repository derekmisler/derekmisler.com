---
import ContactLink from '@/components/ContactLink.astro';
import { contact, fullName, navItems } from '@/constants';
---

<header id={navItems.home.slug} class="border-accent-top border-accent-bottom" aria-labelledby="site-title">
  <h1 id="site-title" class="sticky-header">{fullName}</h1>
  <div class="content-padding">
    <p class="lead">
      <strong class="gradient-text">Platform engineer and front&#x2011;end architect</strong> with 15+ years shipping production&#x2011;grade
      systems. I define how UIs get built: from design&#x2011;system infrastructure and{' '}
      <strong class="gradient-text">AI agent tooling</strong> to the testing contracts and quality bars that make them reliable
      at scale. Currently doing that at{' '}
      <a href="https://www.docker.com" target="_blank" rel="noopener noreferrer">Docker</a>.
    </p>
    <nav aria-label="Contact links">
      {
        contact.map((item) => (
          <ContactLink href={item.href} label={item.label} download={item.download} variant="nav" />
        ))
      }
    </nav>
  </div>
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    justify-content: space-between;
    padding-bottom: var(--space-lg);
    min-height: 100vh;
    @supports (height: 100dvh) {
      min-height: 100dvh;
    }
    @media (min-width: 1024px) {
      padding: 0;
    }
  }
  .content-padding {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    @media (min-width: 1024px) {
      gap: var(--space-md);
    }
  }
  header h1 {
    font-size: var(--font-size-lg);
    font-weight: 400; /* Press Start 2P has no weight variation */
    @media (min-width: 1024px) {
      justify-self: start;
    }
  }
  /* Hero tagline: large body paragraph, not a heading */
  header .lead {
    font-size: var(--font-size-xl);
    font-weight: 450;
    line-height: var(--line-height-heading);
    text-wrap: balance;
    max-width: min(36ch, 100%);
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: space-between;
    @media (min-width: 1024px) {
      justify-content: flex-start;
      gap: var(--space-sm);
    }
  }
</style>
