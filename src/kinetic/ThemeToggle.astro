<button class="theme-toggle" type="button" aria-label="Theme">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <mask id="moon-bite">
        <rect width="32" height="32" fill="white"></rect>
        <circle class="bite" cx="22" cy="10" r="6.5" fill="black"></circle>
      </mask>
      <clipPath id="above-horizon">
        <rect class="sky" width="32" height="32"></rect>
      </clipPath>
    </defs>
    <circle class="orbit" cx="16" cy="16" r="15" fill="none"></circle>
    <g clip-path="url(#above-horizon)">
      <g class="sun">
        <g class="rays">
          {[0, 45, 90, 135, 180, 225, 270, 315].map((angle) => (
            <line x1="16" y1="3.5" x2="16" y2="6.5" transform={`rotate(${angle} 16 16)`} />
          ))}
        </g>
        <circle class="body" cx="16" cy="16" r="6" mask="url(#moon-bite)"></circle>
      </g>
    </g>
    <line class="horizon" x1="5" y1="22" x2="27" y2="22"></line>
    <path class="arrow" d="M13 28.5l3-3 3 3"></path>
    <g class="stars">
      <path d="M7 7.5l.7 1.6 1.6.7-1.6.7-.7 1.6-.7-1.6-1.6-.7 1.6-.7z"></path>
      <path d="M11 3.5l.5 1 1 .5-1 .5-.5 1-.5-1-1-.5 1-.5z"></path>
    </g>
  </svg>
</button>
<span class="sr-only theme-status" aria-live="polite"></span>
